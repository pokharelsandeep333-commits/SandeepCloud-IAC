# Copy to terraform.tfvars (gitignored) and fill in.
zone_id = "<ZONE_ID>"

# How SandeepCloud is reached: "ip" (a server with a public IP) or "tunnel" (Cloudflare
# Tunnel, for a host with no public IP). Switching replaces 4 records (README.md).
sandeepcloud_origin = "ip"

# Used when sandeepcloud_origin is "ip". Changing it is the DNS step of a move
# (docs/RUNBOOK-migrate.md).
sandeepcloud_ip = "<SANDEEPCLOUD_IP>"

# Needed only when sandeepcloud_origin is "tunnel" (the tunnel belongs to the account)
# account_id = "<ACCOUNT_ID>"

# Set enable_adblocker = false before the Ad-Blocker's IP is released; that removes dns.
enable_adblocker = true
adblocker_ip     = "<ADBLOCKER_IP>"
# adblocker_ttl = 60   # only around a move; 1 (Auto) otherwise

dmarc_rua = "<DMARC_REPORT_MAILBOX>"

# Forward rules. The keys must match imports.tf; forward_to must be a verified destination.
email_routes = {
  route1 = { to = "<ADDRESS_1>@sandeeppokharel.com.np", forward_to = "<YOUR_MAILBOX>" }
  route2 = { to = "<ADDRESS_2>@sandeeppokharel.com.np", forward_to = "<YOUR_MAILBOX>" }
}
