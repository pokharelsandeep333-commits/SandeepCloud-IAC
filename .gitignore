# Terraform working data and state (state holds every resource attribute in plain text)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Personal values (IPs, account ID, email); commit terraform.tfvars.example instead
*.tfvars
*.tfvars.json
!*.tfvars.example
# Partial backend config holds the state bucket name, which includes the account ID
backend.hcl

# Secrets never go in this repo
.env
.env.*
*.pem
*.key
*.pfx
id_rsa*
id_ed25519*
*_rsa
*_ed25519
*_ed25519.pub
cloudflare-token*
tailscale-authkey*
# The real AdGuard dashboard allowlist holds the home IP; commit the .example instead
server/adblocker/nginx/adguard-admin-allow.conf

# Scanner output (results go to GitHub code scanning)
results.sarif
*.sarif

# Scratch work
.work/

# Office / OneDrive / Windows clutter
~$*
*.tmp
desktop.ini
Thumbs.db

# Claude Code local-only files
.claude/settings.local.json
.claude/worktrees/

# Python (Checkov venv)
.venv/
__pycache__/
*.pyc
