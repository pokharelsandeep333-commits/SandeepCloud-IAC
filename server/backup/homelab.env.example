# Homelab target over Tailscale. install.sh copies this to /etc/restic/homelab.env (root, 0600).
# Fill it in on the server only. The filled-in file never goes in git.
#
# Recommended: restic's rest-server on the laptop, started with --append-only and
# --private-repos, listening on its Tailscale address only. Append-only means a
# compromised server can add backups but can't delete or overwrite old ones.
RESTIC_REPOSITORY=rest:http://<HOMELAB_TAILSCALE_NAME>:8000/<HOST>/
RESTIC_REST_USERNAME=<HOST>
RESTIC_REST_PASSWORD=<REST_SERVER_PASSWORD>

# Append-only: the server can't forget/prune here; that runs on the laptop.
FORGET=no

# Optional: Uptime Kuma push monitor URL, without the ?status=... part.
PUSH_URL=
