# Cloudflare R2 target. install.sh copies this to /etc/restic/r2.env (root, 0600).
# Fill it in on the server only. The filled-in file never goes in git.
#
# The token: R2 > Manage API tokens > Object Read & Write, limited to this one bucket.
RESTIC_REPOSITORY=s3:https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/<HOST>
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=auto

# This server prunes its own old snapshots in R2 (keep policy in backup.conf).
FORGET=yes

# Optional: Uptime Kuma push monitor URL, without the ?status=... part.
PUSH_URL=
