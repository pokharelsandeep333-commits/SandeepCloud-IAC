# Left out of the SandeepCloud backup (restic --exclude-file): rebuilt, re-downloaded or regenerated.

# Nextcloud logs (190 MB) and thumbnail previews (regenerated on demand)
/var/lib/docker/volumes/sandeepcloud_sandeepcloud_data/_data/data/nextcloud.log*
/var/lib/docker/volumes/sandeepcloud_sandeepcloud_data/_data/data/appdata_*/preview

# The wiki is a git clone, pulled every minute by sync-vault.sh; re-clone it instead
/home/ubuntu/Molecular-Zettelkasten/ec2-deployment/LLM-Wiki
/home/ubuntu/Molecular-Zettelkasten/ec2-deployment/sync-vault.log*

