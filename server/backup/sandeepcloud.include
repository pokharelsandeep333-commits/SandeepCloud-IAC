# What restic backs up on SandeepCloud (restic --files-from: one path or glob per line).
# Sizes measured 2026-10-25, before excludes.

# Compose project: compose file, nginx.conf, .env (DB passwords), Watchtower's registry login
/home/ubuntu/sandeepcloud

# App env files (secrets)
/home/ubuntu/portfolio/.env
/home/ubuntu/ShiftSentry/.env.production
/home/ubuntu/Molecular-Zettelkasten/ec2-deployment

# Nextcloud: config/config.php, user files, custom apps (1.6 GB)
/var/lib/docker/volumes/sandeepcloud_sandeepcloud_data/_data

# MariaDB as nightly logical dumps (about 5.6 MB each, 7 kept), not the live data files
/var/backups/nextcloud

# Uptime Kuma (4 MB)
/home/ubuntu/uptime-kuma

# Cloudflare origin certificate and key
/etc/ssl/cloudflare

# SSH: the deploy key the wiki's git pull uses, and authorized_keys
/home/ubuntu/.ssh

# Host jobs: the DB dump, the Nextcloud cron and the wiki sync (also copied in server/sandeepcloud/)
/usr/local/sbin/nextcloud-db-dump.sh
/etc/cron.d/nextcloud-db-dump
/var/spool/cron/crontabs/ubuntu
/etc/logrotate.d/sandeepcloud-nginx

# Wazuh agent: its identity (a rebuilt server keeps the same agent ID) and its custom config
/var/ossec/etc/client.keys
/var/ossec/etc/ossec.conf
/var/ossec/etc/local_internal_options.conf
