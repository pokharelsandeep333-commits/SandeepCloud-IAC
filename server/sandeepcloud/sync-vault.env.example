# Copy to /home/ubuntu/Molecular-Zettelkasten/ec2-deployment/sync-vault.env
# (owner ubuntu, mode 0600). Read by sync-vault.sh.
# Uptime Kuma push monitor URL, without the ?status=... query string. Kuma runs on the same
# server, published on 127.0.0.1:3001.
PUSH_URL=http://127.0.0.1:3001/api/push/<PUSH_TOKEN>
