# Port 80: unknown names get dropped
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# Port 80: ACME webroot for certbot, everything else -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name dns.sandeeppokharel.com.np;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# Port 443: bare IP / wrong SNI -> TLS handshake refused
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

# Port 443: DoH for everyone, dashboard for allowlisted IPs only
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dns.sandeeppokharel.com.np;

    ssl_certificate     /etc/letsencrypt/live/dns.sandeeppokharel.com.np/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dns.sandeeppokharel.com.np/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_redirect http:// https://;

    location = /dns-query {
        limit_req zone=doh burst=300 nodelay;
        client_max_body_size 64k;
        proxy_pass http://adguard;
    }
    location ^~ /dns-query/ {
        limit_req zone=doh burst=300 nodelay;
        client_max_body_size 64k;
        proxy_pass http://adguard;
    }

    location / {
        include /etc/nginx/adguard-admin-allow.conf;
        deny all;
        proxy_cookie_flags ~ secure httponly samesite=strict;
        proxy_pass http://adguard;
    }
}
